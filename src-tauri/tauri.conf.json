{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskCraft",
  "version": "0.1.0",
  "identifier": "com.pareasy.taskcraft",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "copyright": "Personal use",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "14.0" }
  }
}
